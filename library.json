  "description": "Bibliothèque header-only pour générer des graphiques Google Charts temps réel sur ESP8266/ESP32/Arduino",
  "keywords": [
    "graphique",
    "google-charts",
    "chart",
    "esp8266",
    "esp32",
    "temps-reel",
    "arduino",
    "realtime",
    "visualisation"
  ],
  "authors": [
    {
      "name": "Olivier FOURNET",
      "email": "olivier.fournet@free.fr",
      "url": "https://github.com/Fo170"
    }
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fo170/Graphique_Synchrone.git"
  },
  "homepage": "https://github.com/Fo170/Graphique_Synchrone",
  "headers": ["Graphique_Synchrone.h"],
  "build": {
    "srcFilter": ["-<exemple/>"]
  },
  "platforms": ["espressif8266", "espressif32"],
  "frameworks": ["arduino"],
  "export": {
    "include": ["Graphique_Synchrone.h"]
  }
}
